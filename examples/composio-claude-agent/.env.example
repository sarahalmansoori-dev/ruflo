# Composio × Claude Agent SDK — copy to `.env` and fill in.

# Composio API key — https://dashboard.composio.dev/settings
COMPOSIO_API_KEY=

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: scope the Composio session to a specific end-user (default: "default")
# COMPOSIO_USER_ID=default
